<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · {{ company }}</title>
<style>{{ css|safe }}</style>
</head>
<body>
<main>
<p class="overline">Transcript</p>
<h1>{{ title }}</h1>
<p class="meta">{{ company }} · {{ period }}</p>

<h2>Highlights</h2>
<table>
{% for f in figures %}<tr><th>{{ f.label }}</th><td class="num">{{ f.value }}</td></tr>
{% endfor %}</table>
{% for section in sections %}
<h2>{{ section.title }}</h2>
{% for turn in section.turns %}<div class="turn {{ turn.role }}">
<p class="speaker">{{ turn.speaker }}</p>
{% for p in turn.paragraphs %}<p>{{ p }}</p>
{% endfor %}</div>
{% endfor %}{% endfor %}
{% if headwinds %}<h2>Supplementary Information: Headwinds</h2>
<p class="note">Spread is the reporting party's adjusted rating less that of the leading Comparable.</p>
<table>
{% for h in headwinds %}<tr><th>{{ h.label }}</th><td class="num">{{ h.value }}</td></tr>
{% endfor %}</table>
{% endif %}{% if filings %}<h2>Supplementary Information: Daily Filings</h2>
<table>
{% for f in filings %}<tr><th>{{ f.label }}</th><td class="num">{{ f.value }}</td></tr>
{% endfor %}</table>
{% endif %}
<p class="closing">Prepared by Standing. Figures are computed per the published methodology.</p>
</main>
</body>
</html>
