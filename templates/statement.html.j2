<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · {{ holder }}</title>
<style>{{ css|safe }}</style>
</head>
<body>
<main>
<p class="overline">Statement</p>
<h1>{{ title }}</h1>
<p class="meta">{{ holder }} · {{ period }}</p>
{% for s in sections %}
<h2>{{ s.title }}</h2>
{% if s.note %}<p class="note">{{ s.note }}</p>
{% endif %}{% if s.rows %}<table class="grid">
<tr>{% for c in s.columns %}<th{% if c.numeric %} class="num"{% endif %}>{{ c.label }}</th>{% endfor %}</tr>
{% for row in s.rows %}<tr>{% for cell in row %}<td{% if s.columns[loop.index0].numeric %} class="num"{% endif %}>{{ cell }}</td>{% endfor %}</tr>
{% endfor %}</table>
{% else %}<p class="empty">{{ s.empty }}</p>
{% endif %}{% endfor %}
<p class="closing">Prepared by Standing. Figures are computed as set out in the Methodology.</p>
</main>
</body>
</html>
